# Normalize line endings and mark binary assets.
* text=auto

.gitattributes text eol=lf

# Shell scripts must stay LF.
*.sh text eol=lf

# Source and configuration files use LF on every platform.
*.js text eol=lf
*.mjs text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.md text eol=lf

*.png binary
*.ico binary
*.exe binary

# Git hooks run under sh and must stay LF.
.githooks/* text eol=lf
